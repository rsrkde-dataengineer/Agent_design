ANTHROPIC_API_KEY=

HELPDESK_MODEL=claude-opus-5-5
HELPDESK_EFFORT=medium
HELPDESK_MAX_MODEL_CALLS=12
HELPDESK_MODEL_RETRIES=2

# memory (default) keeps everything in process; spanner persists checkpoints, memories and results.
HELPDESK_STORAGE=memory
HELPDESK_SPANNER_PROJECT=
HELPDESK_SPANNER_INSTANCE=
HELPDESK_SPANNER_DATABASE=
